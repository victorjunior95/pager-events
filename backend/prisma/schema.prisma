// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STAFF
  MANAGER
  ADMIN
}

enum AreaType {
  SETOR
  LOCAL
  EQUIPE
}

enum DemandUrgency {
  NENHUMA
  BAIXA
  MÉDIA
  ALTA
  CRÍTICA
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  areas UserArea[]

  @@map("users")
}

model Area {
  id        String   @id @default(uuid())
  name      String
  type      AreaType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   UserArea[]
  demands DemandArea[]

  @@unique([name, type])
  @@map("areas")
}

model UserArea {
  userId String
  areaId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([areaId])
  @@map("user_areas")
}

model Demand {
  id          String        @id @default(uuid())
  code        String        @unique
  title       String
  description String?
  urgency     DemandUrgency @default(NENHUMA)
  dueAt       DateTime?
  archived    Boolean       @default(false)
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  areas   DemandArea[]
  history DemandHistory[]

  @@index([urgency])
  @@index([archived])
  @@index([dueAt])
  @@map("demands")
}

model DemandArea {
  demandId String
  areaId   String

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([demandId, areaId])
  @@index([areaId])
  @@map("demand_areas")
}

model DemandHistory {
  id        String   @id @default(uuid())
  demandId  String
  createdAt DateTime @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([demandId, createdAt])
  @@map("demand_history")
}
